local activePageRef = nil

local function HideAllPages()
    for _, tabData in ipairs(TabsList) do
        if tabData.Type == "MainWithSub" then
            TweenService:Create(tabData.Btn, SMOOTH_TWEEN, {TextColor3 = Color3.fromRGB(140, 140, 155)}):Play()
            for _, sub in ipairs(tabData.SubTabs) do
                sub.Page.Visible = false
                TweenService:Create(sub.Btn, SMOOTH_TWEEN, {TextColor3 = Color3.fromRGB(100, 100, 115)}):Play()
                if sub.Indicator then sub.Indicator.Visible = false end
            end
        elseif tabData.Type == "Direct" then
            tabData.Page.Visible = false
            TweenService:Create(tabData.Btn, SMOOTH_TWEEN, {TextColor3 = Color3.fromRGB(140, 140, 155)}):Play()
            if tabData.Indicator then tabData.Indicator.Visible = false end
        end
    end
end

