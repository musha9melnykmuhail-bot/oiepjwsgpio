    local activeIndicator = Instance.new("Frame")
    activeIndicator.Name = "Indicator"
    activeIndicator.Size = UDim2.new(0, 3, 0, 24)
    activeIndicator.Position = UDim2.new(0, 4, 0.5, -12)
