local function AddMainTab(tabName, hasSubTabs)
    local tabObj = {Name = tabName, Type = hasSubTabs and "MainWithSub" or "Direct", SubTabs = {}}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
    btn.BorderSizePixel = 0
    btn.Text = "  " .. tabName
    btn.TextColor3 = Color3.fromRGB(255, 255, 255) -- Вкладки на виду белым
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Sidebar
    tabObj.Btn = btn

    if hasSubTabs then
        local subContainer = Instance.new("Frame")
        subContainer.Size = UDim2.new(1, 0, 0, 0)
        subContainer.BackgroundTransparency = 1
        subContainer.ClipsDescendants = true
        subContainer.Parent = Sidebar
        
        local subLayout = Instance.new("UIListLayout")
        subLayout.SortOrder = Enum.SortOrder.LayoutOrder
        subLayout.Parent = subContainer

        tabObj.SubContainer = subContainer
        tabObj.Expanded = false

        btn.MouseButton1Click:Connect(function()
            -- Закрываем другие
            for _, t in ipairs(TabsList) do
                if t ~= tabObj and t.Type == "MainWithSub" and t.Expanded then
                    t.Expanded = false
                    TweenService:Create(t.SubContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                end
            end
            
            tabObj.Expanded = not tabObj.Expanded
            local targetHeight = tabObj.Expanded and (#tabObj.SubTabs * 30) or 0
            TweenService:Create(subContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            
            -- Если открыли вкладку с подменю, автоматом кликаем первую
            if tabObj.Expanded and #tabObj.SubTabs > 0 then
                HideAllPages()
                activePageRef = tabObj.SubTabs[1]
                tabObj.SubTabs[1].Page.Visible = true
                tabObj.SubTabs[1].Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end)
    else
        local pageData = CreateContentPage(tabName)
        tabObj.Page = pageData.Page
        tabObj.PageObj = BuildTabObj(pageData)

        btn.MouseButton1Click:Connect(function()
            HideAllPages()
            activePageRef = tabObj.PageObj
            tabObj.Page.Visible = true
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)

            -- Закрываем открытые сабтабы других вкладок
            for _, t in ipairs(TabsList) do
                if t.Type == "MainWithSub" and t.Expanded then
                    t.Expanded = false
                    TweenService:Create(t.SubContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                end
            end
        end)
    end

    table.insert(TabsList, tabObj)
    return tabObj
end

local function AddSubTab(parentTab, subName)
    local subBtn = Instance.new("TextButton")
    subBtn.Size = UDim2.new(1, 0, 0, 30)
    subBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 22) -- челка плавно серая
    subBtn.BorderSizePixel = 0
    subBtn.Text = "    " .. subName
    subBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    subBtn.Font = Enum.Font.GothamMedium
    subBtn.TextSize = 12
    subBtn.TextXAlignment = Enum.TextXAlignment.Left
    subBtn.Parent = parentTab.SubContainer

    local pageData = CreateContentPage(subName)
    local pageObj = BuildTabObj(pageData)

    local subObj = {Btn = subBtn, Page = pageData.Page, PageObj = pageObj}
    table.insert(parentTab.SubTabs, subObj)

    subBtn.MouseButton1Click:Connect(function()
        HideAllPages()
        activePageRef = pageObj
        pageData.Page.Visible = true
        subBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    return pageObj
end

