        subBtn.TextXAlignment = Enum.TextXAlignment.Left
        subBtn.Parent = TabContainer
        
        local subCorner = Instance.new("UICorner")
        subCorner.CornerRadius = UDim.new(0, 4)
        subCorner.Parent = subBtn
        
