local function HideAllPages()
    for _, tabData in ipairs(TabsList) do
        if tabData.Type == "MainWithSub" then
            for _, sub in ipairs(tabData.SubTabs) do
                sub.Page.Visible = false
                sub.Btn.TextColor3 = Color3.fromRGB(150, 150, 150) -- Неактивная подвкладка серая
            end
        elseif tabData.Type == "Direct" then
            tabData.Page.Visible = false
            tabData.Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end
end

