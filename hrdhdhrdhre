    }
    
    function tabObj:CreateSubTab(name)
        local subPage = Instance.new("Frame")
        subPage.Name = name .. "SubPage"
        subPage.Size = UDim2.new(1, 0, 1, 0)
        subPage.BackgroundTransparency = 1
        subPage.Visible = false
        subPage.Parent = page
        
